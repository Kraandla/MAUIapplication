<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaPlace.Views.PizzaDetails"
             x:Name = "PizzaMenuBackground"
             BackgroundColor="{StaticResource PrimaryLight}">
    <ScrollView
        HorizontalScrollBarVisibility="Never"
        VerticalScrollBarVisibility="Default">
        <VerticalStackLayout
            x:Name = "MainContentLayout"
            Padding="30, 50"
            BackgroundColor="{StaticResource PrimaryLight}">
            <Grid 
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto">

            
                <Border 
                    Grid.Row="0" 
                    Grid.ColumnSpan="2"
                     Margin="24,0,24,0"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="5"
                    StrokeShape="RoundRectangle 16">
                    
                    <Grid  
                        Padding="20" 
                        ColumnDefinitions="Auto,*,Auto">

                        <ImageButton 
                            Grid.Column="0"
                            WidthRequest="24"
                            HeightRequest="24"
                            Source="back_button.png"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Clicked="BackButton_Clicked"/>

                        <Label
                            Grid.Column="1"
                            HorizontalTextAlignment="Center"
                            VerticalOptions="Center"
                            TextColor="{StaticResource Black}"
                            Style="{StaticResource PageHeadingH1}"
                            Text="{Binding Name}"/>

                        <ImageButton 
                            Grid.Column="2"
                            WidthRequest="34"
                            HeightRequest="34"
                            Source="menu.png"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="MenuButton_Clicked"/>
                    </Grid>
                </Border>

                <!--main Content-->
                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="24,16,24,0"
                    Spacing="5">

                      <Border
                        Stroke="{StaticResource Primary}"
                        BackgroundColor="{StaticResource White}"
                        StrokeThickness="6"
                        Padding="16"
                        StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="5">

                            <Image
                                Source="{Binding Image}"
                                Aspect="AspectFit"
                                HorizontalOptions="Fill"
                                HeightRequest="340"
                                Margin="2"/>
                            <Rectangle
                             HorizontalOptions="Fill"
                             HeightRequest="2"
                             StrokeThickness="6"
                             Fill="{StaticResource Primary}"/>

                            <Label
                           
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource Black}"
                                Style="{StaticResource MainInfoLabel}"
                                VerticalTextAlignment="Center"
                                >
                                <Label.Text>
                                    <MultiBinding StringFormat="Size: {0} cm">
                                        <Binding Path="Size" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        
                          
                            <Label
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource Black}"
                                Style="{StaticResource MainInfoLabel}"
                                >
                                <Label.Text>
                                    <MultiBinding StringFormat="Toppings:  {0}">
                                        <Binding Path="Toppings" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource Black}"
                                Style="{StaticResource MainInfoLabel}">
                                <Label.Text>
                                    <MultiBinding StringFormat="Sauce: {0}">
                                        <Binding Path="Sauce"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Label
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource Black}"
                                Style="{StaticResource MainInfoLabel}">
                                <Label.Text>
                                    <MultiBinding StringFormat="Price: {0} €">
                                        <Binding Path="Price"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>


                        </VerticalStackLayout>
                    </Border>

                    <!--Edit delete pizza buttons-->
                    <Button  
                        HorizontalOptions="Center"  
                        Margin="0,0,0,0"  
                        Style="{StaticResource BottomButton}" 
                        BackgroundColor="{StaticResource Primary}"
                        WidthRequest="300"
                        Text="Edit Pizza"
                        Clicked="EditButton_Clicked"/>
                    <Button  
                        HorizontalOptions="Center"  
                        Margin="0,0,0,0"  
                        Style="{StaticResource BottomButton}" 
                        BackgroundColor="{StaticResource Danger}"
                        WidthRequest="300"
                        Text="Delete"
                        Clicked="DeleteButton_Clicked"/>

                </VerticalStackLayout>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>