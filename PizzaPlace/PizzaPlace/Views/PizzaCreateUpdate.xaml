<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PizzaPlace.ViewModels"
             x:Class="PizzaPlace.Views.PizzaCreateUpdate"
             Title="PizzaCreateUpdate">

    <ContentPage.BindingContext>
        <viewmodels:CreateUpdateViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource PrimaryGradient}" Offset="1.0"/>
            <GradientStop Color="{StaticResource PrimaryLight}" Offset="0.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
    <VerticalStackLayout
        x:Name = "MainContentLayout"
        Padding="30, 50">
            <Border 
                Grid.Row="0" 
                Grid.ColumnSpan="2"
                Margin="0, 4,0 ,0"
                Stroke="{StaticResource Primary}"
                BackgroundColor="{StaticResource Primary}"
                StrokeThickness="5"
                StrokeShape="RoundRectangle 16">
                <Grid  
                    Padding="20" 
                    ColumnDefinitions="Auto,*,Auto">

                    <ImageButton
                      Grid.Column="0"
                      WidthRequest="40"
                      HeightRequest="40"
                      Source="back_button.png"
                      HorizontalOptions="Start"
                      VerticalOptions="Center"
                      Clicked="BackButton_Clicked">
                    </ImageButton>

                    <Label
                      Grid.Column="1"
                      Style="{StaticResource PageHeadingH1}"
                      Text="Create/Update"
                      TextColor="{StaticResource Black}"
                      HorizontalTextAlignment="Center"
                      VerticalOptions="Center"/>

                    <ImageButton 
                      Grid.Column="2"
                      WidthRequest="34"
                      HeightRequest="34"
                      Source="menu.png"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      Clicked="MenuButton_Clicked"/>
                </Grid>
            </Border>

            <HorizontalStackLayout
                Margin="0,20"
                Grid.Row="1"
                Grid.Column="0">
            </HorizontalStackLayout>


        <!--Input box fields-->
        <Border
            BackgroundColor="{StaticResource White}"
            Stroke="{StaticResource Primary}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="3">
        
        <VerticalStackLayout Padding="10">
            
        <!--Name input box-->
        <Grid
            Style="{StaticResource InputBoxGrid}">
            <Label Text="Name:" Style="{StaticResource MainInfoLabel}"/>
            <Entry
                Text="{Binding Pizza.Name}"
                Placeholder="Name the Pizza"
                Grid.Column="1"
                Style="{StaticResource CreateUpdateInputBox}"
                >
            </Entry>
        </Grid>
        
        <!--Size input box-->
        <Grid
            Style="{StaticResource InputBoxGrid}">
            <Label Text="Size:" Style="{StaticResource MainInfoLabel}"/>
            <Entry
                Text="{Binding Pizza.Size}"
                Placeholder="Price the Pizza"
                Grid.Column="1"
                Style="{StaticResource CreateUpdateInputBox}"
                >
            </Entry>
        </Grid>
        
        <!--Toppings info box-->
        <Grid
            Style="{StaticResource InputBoxGrid}">
            <Label Text="Toppings:" Style="{StaticResource MainInfoLabel}"/>
            <Entry
                Text="{Binding Pizza.Toppings}"
                Placeholder="Price the Pizza"
                Grid.Column="1"
                Style="{StaticResource CreateUpdateInputBox}"
                >
            </Entry>
        </Grid>
        
        <!--Sauce info box-->
        <Grid
            Style="{StaticResource InputBoxGrid}">
            <Label Text="Sauce:" Style="{StaticResource MainInfoLabel}"/>
            <Entry
                Text="{Binding Pizza.Sauce}"
                Placeholder="Sauce the Pizza"
                Grid.Column="1"
                Style="{StaticResource CreateUpdateInputBox}"
                >
            </Entry>
        </Grid>
            
        <!--Price input box-->
        <Grid
            Style="{StaticResource InputBoxGrid}">
            <Label Text="Price:" Style="{StaticResource MainInfoLabel}"/>
            <Entry
                Text="{Binding Pizza.Price}"
                Placeholder="Price the Pizza"
                Grid.Column="1"
                Style="{StaticResource CreateUpdateInputBox}"
                >
            </Entry>
        </Grid>

        <!--Image input container-->
        <Grid>
            <Label
                Margin="0,0,0,0"
                Text="{Binding PizzaImageName}"
                TextColor="{StaticResource Black}"
                BackgroundColor="{StaticResource PrimaryLight}"
                FontFamily="Lato-Light"
                FontSize="24"
                HeightRequest="46"
                Padding="5,0,0,0"
                HorizontalOptions="Fill"/>

            <HorizontalStackLayout
                Padding="0"
                HorizontalOptions="End">
                <Button
                    HorizontalOptions="Center"
                    Margin="0"
                    Style="{StaticResource AddRemovePictureButton}"
                    Command="{Binding PickImageCommand}"
                    Text="Add">
                </Button>
                <Button
                    HorizontalOptions="Center"
                    Margin="0"
                    Style="{StaticResource AddRemovePictureButton}"
                    Command="{Binding DeleteImageCommand}"
                    Text="Del"></Button>
            </HorizontalStackLayout>
        </Grid>
                    <!--Image Preview-->
                    <Border
                        Margin="0,10,0,0"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                        BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 10">
                        <Image
            Source="{Binding Pizza.Image}"
            Aspect="AspectFit"
            HeightRequest="200"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>
        </Border>

        <!--Save pizza button-->
        <Button  
                HorizontalOptions="Fill"  
                Margin="0,20,0,0"  
                Style="{StaticResource BottomButton}" 
                Text="Save Pizza"
                Command="{Binding SavePizzaCommand}"/>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>