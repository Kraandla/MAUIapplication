<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaPlace.Views.PizzaCreateUpdate"
             Title="PizzaCreateUpdate">
    <VerticalStackLayout
        x:Name = "MainContentLayout"
        Padding="30, 50"
        BackgroundColor="{StaticResource PrimaryLight}">

        <HorizontalStackLayout
            Spacing="64"
            Grid.Row="0"
            Grid.Column="0">

            <ImageButton
                WidthRequest="40"
                Source="back_button.png"
                HorizontalOptions="Start">
            </ImageButton>

            <!--replace fontsize textcolor with style resource when available-->
            <Label
                Text="Create/Update"
                TextColor="{StaticResource Black}"
                FontSize="34"
                VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout
            Margin="0,20"
            Grid.Row="1"
            Grid.Column="0">
        </HorizontalStackLayout>

        <!--Name input box-->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*">
            <Label
                Margin="0,5,0,0"
                Text="Pizza Name:"
                TextColor="{StaticResource Black}"
                FontSize="24"
                HorizontalOptions="Center"/>
            <Entry
                Margin="10,0,0,0"
                Placeholder="Name the Pizza"
                TextColor="{StaticResource Black}"
                BackgroundColor="{StaticResource White}"
                FontSize="20"
                VerticalOptions="Start"
                Grid.Column="1"
                >
            </Entry>
        </Grid>
        
        
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*">
            <Label
                Margin="0,5,0,0"
                Text="Size:"
                TextColor="{StaticResource Black}"
                FontSize="24"
                HorizontalOptions="Center"/>
            <Entry
                Margin="10,0,0,0"
                Placeholder="Name the Pizza"
                TextColor="{StaticResource Black}"
                BackgroundColor="{StaticResource White}"
                FontSize="20"
                VerticalOptions="Start"
                Grid.Column="1"
                >
            </Entry>
        </Grid>
    </VerticalStackLayout>
</ContentPage>