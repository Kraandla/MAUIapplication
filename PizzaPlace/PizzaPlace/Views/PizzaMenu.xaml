<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaPlace.Views.PizzaMenu"
             Title="PizzaMenu">


    <ScrollView
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="2"
        HorizontalScrollBarVisibility="Never"
        VerticalScrollBarVisibility="Never"
        Margin="24,16,24,0">
        <VerticalStackLayout
            x:Name = "PizzaMenuBackground"
            Padding="30, 50"
            BackgroundColor="{StaticResource PrimaryLight}">

        <!-- Header - Full Width -->
        <Grid Grid.Row="0" 
                  Grid.ColumnSpan="2" 
                  Padding="20" 
                  BackgroundColor="{StaticResource Primary}"
                  ColumnDefinitions="Auto,*,Auto">

            <ImageButton 
                    Grid.Column="0"
                    WidthRequest="24"
                    HeightRequest="24"
                    Source="back_button.png"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Clicked="BackButton_Clicked"/>

            <Label
                    Grid.Column="1"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center"
                    TextColor="{StaticResource Black}"
                    Style="{StaticResource BoldText}"
                    Text="{Binding Name}"/>

            <ImageButton 
                    Grid.Column="2"
                    WidthRequest="24"
                    HeightRequest="24"
                    Source="imgmenu.png"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="MenuButton_Clicked"/>
        </Grid>

            <VerticalStackLayout>
                <Button 
                    Margin="0,24,0,14"
                    HorizontalOptions="Center"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource BottomButton}"
                    Text="Add Pizza"
                    Clicked="CreatePizza_Clicked"/>
                
                <CollectionView
                x:Name="PizzaMenuItems"
                IsVisible="False"
                SelectionMode="Single"
                SelectionChanged="PizzaMenuItems_SelectionChanged">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="8"
                                       />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>

                <DataTemplate>
                    <Border 
                            Stroke="{StaticResource Primary}"
                            BackgroundColor="{StaticResource White}"
                            StrokeThickness="6"
                            StrokeShape="RoundRectangle 16,16,16,16"
                            Padding="0, 0, 0, 0"
                            HorizontalOptions="Center">

                        <Grid 
                                ColumnDefinitions="200, *, Auto" 
                                RowDefinitions="Auto, Auto, Auto, Auto" 
                                ColumnSpacing="0"
                                Padding="32,24">


                            <Image 
                                    Source="{Binding Image}"
                                    Grid.RowSpan="4"
                                    Grid.Column="0"
                                    WidthRequest="240"
                                    HeightRequest="240"
                                    Aspect="AspectFit"
                                    Margin="0,-180,140,-240"/>

                            <Label 
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    Style="{StaticResource PageHeadingH1}"/>

                            <Label Grid.Row="0"
                                        Grid.Column="2"
                                        Text="{Binding Price, StringFormat='€{0:F2}'}"
                                        Style="{StaticResource PageHeadingH1}" />

                            <Label Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Size, StringFormat='∅ {0} cm'}"
                                        Style="{StaticResource ParagraphText}" />


                            <!--<Label Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{Binding Toppings, StringFormat='Toppings: {0}'}"
                                        Style="{StaticResource ParagraphText}" />

                                <Label Grid.Row="3"
                                        Grid.Column="1"
                                        Text="{Binding Sauce, StringFormat='Sauce: {0}'}"
                                        Style="{StaticResource ParagraphText}" />-->

                        </Grid>
                    </Border>
                </DataTemplate>

            </CollectionView.ItemTemplate>
            </CollectionView>
            </VerticalStackLayout>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>