<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaPlace.Views.PizzaMenu"
             Title="PizzaMenu">

    <ContentPage.Content>
        <Grid>
            <CollectionView
                x:Name="PizzaMenuItems"
                IsVisible="False"
                SelectionMode="Single"
                SelectionChanged="PizzaMenuItems_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" />
                            <Label Text="{Binding Size}" />
                            <Label Text="{Binding Toppings}" />
                            <Label Text="{Binding Sauce}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>