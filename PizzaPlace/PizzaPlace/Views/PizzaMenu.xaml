<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaPlace.Views.PizzaMenu"
             Title="PizzaMenu">

    <ContentPage.Content>

        <VerticalStackLayout
            x:Name = "PizzaMenuBackground"
            Padding="30, 50"
            BackgroundColor="{StaticResource PrimaryLight}">

            <HorizontalStackLayout
                Spacing="64"
                Grid.Row="0"
                Grid.Column="0">

                <ImageButton
                WidthRequest="40"
                Source="back_button.png"
                HorizontalOptions="Start"
                Clicked="BackButton_Clicked">
                </ImageButton>


                <Label
                Text="Pizza Menu"
                TextColor="{StaticResource Black}"
                Style="{StaticResource PageHeadingH1}"
                VerticalOptions="Center"
                HorizontalOptions="Center"/>
            </HorizontalStackLayout>
            
            <CollectionView
                x:Name="PizzaMenuItems"
                IsVisible="False"
                SelectionMode="Single"
                SelectionChanged="PizzaMenuItems_SelectionChanged">

                
                <CollectionView.ItemTemplate>
                    
                    <DataTemplate>
                        <Frame 
                            Margin="10"
                            Padding="10"
                            BackgroundColor="{StaticResource White}"
                            BorderColor="{StaticResource Primary}">

                            <Grid 
                                ColumnDefinitions="100, *, Auto" 
                                RowDefinitions="Auto, Auto, Auto, Auto" 
                                ColumnSpacing="10"
                                Padding="10">
                           

                                <Image 
                                    Source="{Binding Image}"
                                    Grid.RowSpan="4"
                                    Grid.Column="0"
                                    WidthRequest="80"
                                    HeightRequest="80"
                                    Aspect="AspectFill"
                                    VerticalOptions="Center"/>
                                    
                                <Label 
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    Style="{StaticResource PageHeadingH1}"/>
                                
                                <Label Grid.Row="0"
                                        Grid.Column="2"
                                        Text="{Binding Price, StringFormat='€{0:F2}'}"
                                        Style="{StaticResource PageHeadingH1}" />

                                <Label Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Size, StringFormat='∅ {0} cm'}"
                                        Style="{StaticResource PageHeadingH2}" />
                                
                                        
                                <Label Grid.Row="2"
                                        Grid.Column="1"
                                        Text="{Binding Toppings, StringFormat='Toppings: {0}'}"
                                        Style="{StaticResource ParagraphText}" />

                                <Label Grid.Row="3"
                                        Grid.Column="1"
                                        Text="{Binding Sauce, StringFormat='Sauce: {0}'}"
                                        Style="{StaticResource ParagraphText}" />

                            </Grid>
                        </Frame>
                    </DataTemplate>

                </CollectionView.ItemTemplate>
            </CollectionView>
 
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>