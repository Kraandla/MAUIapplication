<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaPlace.Views.PizzaMenu"
             Title="PizzaMenu">

    <ContentPage.Content>
        
        <VerticalStackLayout
            x:Name = "PizzaMenuBackground"
            Padding="30, 50"
            BackgroundColor="{StaticResource PrimaryLight}">

                <Grid>
                    <CollectionView
                    x:Name="PizzaMenuItems"
                    IsVisible="False"
                    SelectionMode="Single"
                    SelectionChanged="PizzaMenuItems_SelectionChanged">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                
                                    <Label Text="Name: "  Style="{StaticResource PageHeadingH2}"/>
                                    <Label Text="{Binding Name}"  Style="{StaticResource ParagraphText}"/>
                                
                                    <Label Text="Size: "  Style="{StaticResource PageHeadingH2}" />
                                    <Label Text="{Binding Size}"  Style="{StaticResource ParagraphText}" />
                                    
                                    <Label Text="Toppings: "  Style="{StaticResource PageHeadingH2}"/>
                                    <Label Text="{Binding Toppings}"  Style="{StaticResource ParagraphText}"/>
                                    
                                    <Label Text="Sauce: "  Style="{StaticResource PageHeadingH2}"/>
                                    <Label Text="{Binding Sauce}"  Style="{StaticResource ParagraphText}"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>